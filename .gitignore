# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# macOS
.DS_Store

# LaTeX build artifacts (scoped to paper/ dirs so result logs elsewhere survive)
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.out
paper/**/*.synctex.gz
paper/**/*.toc

# Large regenerable outputs
# Certificates and small CSVs ARE committed on purpose — they are results.
# Anything above ~10 MB should live on Zenodo instead and be referenced
# from the conjecture's data manifest.
*.npy
*.npz
*.pkl

# chowla session-2 C tools: build from source, do not commit -march=native binaries
conjectures/chowla/lambda_coverage
conjectures/chowla/lambda_coverage_v*
conjectures/chowla/firstocc_stats

# compiled searchers (rebuilt by gcc -O2 from the .c sources)
conjectures/additive-squares/afsf
conjectures/additive-squares/afsfv

# compiled searchers (rebuilt by gcc -O3 from the .c sources)
conjectures/circular-thresholds/dejean_morph
conjectures/circular-thresholds/dejean_fixpoint

# session-transient build area (solver sources and binaries; rebuilt per session)
work/

# compiled searcher (rebuilt by gcc -O2 from sds_search.c)
conjectures/signed-difference-sets/sds_search
# DSS engines: build from source (gcc -O3 -march=native -fopenmp), do not commit binaries
conjectures/distinct-subset-sums/dss_search
conjectures/distinct-subset-sums/dss_search3
conjectures/distinct-subset-sums/dss_search_basic

# graham-105 engine: build from source (gcc -O3 -march=native), do not commit
conjectures/graham-105/engine
conjectures/graham-105/engine_td
conjectures/graham-105/data/tasks600_130.txt

# peaceable-queens engines: build from source (gcc -O2 -march=native), do not commit
conjectures/peaceable-queens/bnb
conjectures/peaceable-queens/check_peaceable
*.part

# odd-giuga kernel: build from source (gcc -O2 -shared -fPIC), do not commit
conjectures/odd-giuga/kernel.so

# odd-giuga: fat regenerable resume ledgers (100MB+); official run records ARE committed
conjectures/odd-giuga/results/resume_control_*.jsonl
conjectures/odd-giuga/results/resume_giuga9.jsonl

# live solver artifacts (proofs shipped deliberately in certs/ only)
conjectures/projective-chromatic/*.proof
conjectures/projective-chromatic/combined.out
